GEMINI_API_KEY=
ADV_ARCHON_DEFAULT_MODE=cloud
ADV_ARCHON_DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Modelo Ollama por defecto (fallback para tareas sin modelo específico)
ADV_ARCHON_DEFAULT_OLLAMA_MODEL=llama3.1:8b

# Para usar DeepSeek localmente via Ollama, cambia a local y configura los modelos:
# ADV_ARCHON_DEFAULT_MODE=local
# ADV_ARCHON_DEFAULT_OLLAMA_MODEL=deepseek-r1:14b

ADV_ARCHON_OLLAMA_BASE_URL=http://127.0.0.1:11434
PORCUPINE_ACCESS_KEY=
# Opcional: fallback premium de geocodificacion (no necesario para el flujo gratis actual)
GOOGLE_GEOCODING_API_KEY=

# --- Routing DeepSeek por tarea (configurable en ~/.adv-archon/config.toml) ---
# [llm]
# coding_local_model   = "deepseek-r1:14b"   # coding siempre va a local
# reasoning_local_model = "deepseek-r1:32b"  # research/razonamiento profundo (local)
# fast_local_model     = "deepseek-r1:7b"    # respuestas rápidas / planner
# planner_local_model  = "deepseek-r1:7b"    # decisiones de herramienta
# document_local_model = "deepseek-r1:14b"   # lectura de documentos / study
