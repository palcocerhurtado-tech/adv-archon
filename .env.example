GEMINI_API_KEY=
ADV_ARCHON_DEFAULT_MODE=cloud
ADV_ARCHON_DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Modelo Ollama por defecto (fallback para tareas sin modelo específico)
ADV_ARCHON_DEFAULT_OLLAMA_MODEL=llama3.1:8b

# Para usar Ollama localmente, cambia a local y configura los modelos:
# ADV_ARCHON_DEFAULT_MODE=local
# ADV_ARCHON_DEFAULT_OLLAMA_MODEL=llama3.1:8b

ADV_ARCHON_OLLAMA_BASE_URL=http://127.0.0.1:11434
PORCUPINE_ACCESS_KEY=
# Opcional: fallback premium de geocodificacion (no necesario para el flujo gratis actual)
GOOGLE_GEOCODING_API_KEY=

# --- Routing local por tarea (configurable en ~/.adv-archon/config.toml) ---
# [llm]
# coding_local_model    = "deepseek-r1:14b" # tareas pesadas bajo demanda
# reasoning_local_model = "llama3.1:8b"     # razonamiento interactivo
# fast_local_model      = "llama3.2:3b"     # respuestas rápidas / routing
# planner_local_model   = "llama3.2:3b"     # decisiones de herramienta
# document_local_model  = "llama3.1:8b"     # lectura de documentos / study
